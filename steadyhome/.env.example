# Environment Variables  (copy to .env and fill in; .env is git-ignored)
SIMULATED_NOW=2026-11-10T09:00:00
DATABASE_URL=sqlite:///./steadyhome.db
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast?latitude=19.0760&longitude=72.8777&current_weather=true
PORT=8000
FRONTEND_PORT=3000

# --- Gemini (https://aistudio.google.com/apikey) ---
# With a key set, Gemini understands free-form / spoken caller speech (intent, ID, DOB, amount).
# Without it the deterministic rule-based parser is used.
USE_EXTERNAL_LLM=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Supabase (Project Settings -> API) ---
# Run database/supabase_schema.sql in the Supabase SQL editor first.
# Use the service_role key: the backend is the only client, tables have RLS enabled with no public policies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Login (demo credentials; change for anything beyond a demo) ---
AUTH_REQUIRED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SteadyAdmin@2026
AUTH_SECRET=steadyhome-demo-secret-change-me
